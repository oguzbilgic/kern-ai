{
  "name": "kern-ai",
  "version": "0.44.0-next",
  "description": "Simple agent runtime. Persistent memory, tools, Telegram.",
  "type": "module",
  "bin": {
    "kern": "./dist/index.js",
    "kern-ai": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "skills",
    "docs",
    "web/out"
  ],
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc",
    "build:web": "cd web && npm run build",
    "prepublishOnly": "npm run build",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "tsx --test test/*.test.ts"
  },
  "keywords": [
    "ai",
    "agent",
    "llm",
    "telegram",
    "cli",
    "runtime",
    "memory",
    "stateful"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/oguzbilgic/kern-ai"
  },
  "author": "Oguz Bilgic",
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.122",
    "@ai-sdk/mcp": "^1.0.36",
    "@ai-sdk/openai": "^3.0.48",
    "@ai-sdk/openai-compatible": "^2.0.81",
    "@breezystack/lamejs": "^1.2.7",
    "@inquirer/prompts": "^8.3.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openrouter/ai-sdk-provider": "^2.3.3",
    "@slack/bolt": "^4.6.0",
    "ai": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.4",
    "grammy": "^1.35.0",
    "ink": "^7.1.1",
    "ink-spinner": "^5.0.0",
    "marked": "^18.0.13",
    "nostr-tools": "^2.25.2",
    "react": "^19.2.4",
    "semver": "^7.8.5",
    "sqlite-vec": "^0.1.8",
    "turndown": "^7.2.4",
    "unpdf": "^1.8.1",
    "ws": "^8.21.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.19.15",
    "@types/react": "^19.2.14",
    "@types/semver": "^7.8.0",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
